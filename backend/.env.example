# Copiar este archivo como .env y completar los valores.
# El .env no se sube al repositorio.

# Conexión a PostgreSQL: usuario, contraseña, servidor, puerto y nombre de la base
DATABASE_URL=postgresql://user:pass@localhost:5432/foodstore_db

# Clave para firmar el JWT, de al menos 32 caracteres. Para generar una:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambiar-esta-clave-de-al-menos-32-caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Origen del frontend permitido por CORS
FRONTEND_ORIGIN=http://localhost:5173
